# =============================================
# CRM QUANTUN Digital — Variables de Entorno
# Copia este archivo a .env y rellena los valores
# =============================================

# Base de Datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crm_quantun
DB_USER=tu_usuario_db
DB_PASS=tu_password_db

# Aplicación
APP_NAME=CRM QUANTUN Digital
APP_URL=https://tudominio.com/crm
APP_DEBUG=false

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://tu-evolution-api.com
EVOLUTION_API_KEY=tu_api_key_aqui
EVOLUTION_INSTANCE=quantun_instance

# Webhook Security
WEBHOOK_TOKEN=TU_TOKEN_SECRETO

# Cron secret — token para llamar el cron de notificaciones por URL desde Hostinger
# Usar en cPanel: wget "https://tudominio.com/crm/api/enviar_notif_renovacion.php?cron_token=VALOR"
CRON_SECRET=cambia_este_token_secreto

# Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads/facturas/

# Email / SMTP
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=contacto@quantundigital.com
MAIL_PASSWORD=tu_password_zoho
MAIL_FROM_ADDRESS=contacto@quantundigital.com
MAIL_FROM_NAME=QUANTUN Digital

# Notificaciones administrativas
ADMIN_EMAIL=alberthoanayap@gmail.com

# reCAPTCHA v3 (obtener claves reales en https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=tu_site_key
RECAPTCHA_SECRET_KEY=tu_secret_key
RECAPTCHA_MIN_SCORE=0.5
